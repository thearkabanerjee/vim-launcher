{
  "name": "neovim-ghostty-launcher",
  "productName": "Neovim Launcher",
  "version": "1.0.0",
  "description": "A tiny macOS Electron launcher that opens a fresh Ghostty window running Neovim.",
  "main": "main.js",
  "author": "Arka Banerjee",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.4.2",
    "@electron-forge/maker-dmg": "^6.4.2",
    "@electron-forge/maker-zip": "^6.4.2",
    "electron": "^44.4.1"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Neovim Launcher",
        "appBundleId": "com.arkabanerjee.neovimlauncher",
        "asar": true,
        "icon": "./icon.icns",
        "extendInfo": {
          "LSMinimumSystemVersion": "12.0"
        },
        "hooks":{
          "postPackage": "./post-package.js"
        }
      },
      "makers": [
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        }
      ]
    }
  }
}